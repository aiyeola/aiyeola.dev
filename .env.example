FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= 
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
BUTTONDOWN_API_KEY=
SESSION_KEY=
OAUTH_CLIENT_KEY=
OAUTH_CLIENT_SECRET=
REDIS_URL=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional: redirect URI used by `yarn spotify:token` to mint a refresh token.
# Must match a Redirect URI registered on the Spotify app (default 127.0.0.1:8888).
SPOTIFY_REDIRECT_URI=
NEXT_PUBLIC_DOMAIN_NAME=
# Cloudflare Turnstile — bot protection on the subscribe + guestbook forms.
# Local dev test keys (always passes): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA. Use site key
# 2x00000000000000000000AB to force a failure. Without the secret set, the
# server-side check no-ops and the forms are unprotected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Frontend hostnames siteverify is allowed to report, comma separated. Set per
# deployment: "aiyeola.dev" in production, "example.com" locally (what the test
# keys report). Never list localhost or 127.0.0.1 in production. Leaving this
# empty while the secret is set rejects every submission by design.
TURNSTILE_HOSTNAMES=
NODE_OPTIONS=--openssl-legacy-provider
